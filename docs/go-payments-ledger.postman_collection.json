              "raw": "{{base_url}}/v1/transfers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from_account_id\": \"{{account_a}}\",\n  \"to_account_id\": \"{{account_b}}\",\n  \"amount\": 2500,\n  \"currency\": \"BRL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 created or 200 replayed\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "if (pm.response.code === 200) {",
                  "  pm.test(\"replay header present\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));",
                  "}"
                ]
              }
            }
          ]
        },
