    {
      "name": "2. Webhooks",
      "item": [
        {
          "name": "Webhook - payment.succeeded (send twice to test dedupe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Signature",
                "value": "{{webhook_signature}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/webhooks/acmepay",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "webhooks",
                "acmepay"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{webhook_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Monta o corpo do webhook e assina com HMAC-SHA256, igual a um provedor real.",
                  "// A assinatura é calculada sobre \"<timestamp>.<corpo>\", exatamente como o servidor verifica.",
                  "const secret = pm.collectionVariables.get(\"webhook_secret\");",
                  "const body = JSON.stringify({",
                  "  id: pm.collectionVariables.get(\"event_id\"),",
                  "  type: \"payment.succeeded\",",
                  "  data: {",
                  "    account_id: pm.collectionVariables.get(\"account_a\"),",
                  "    amount: Number(pm.collectionVariables.get(\"deposit_amount\")),",
                  "    currency: \"BRL\"",
                  "  }",
                  "});",
                  "const ts = Math.floor(Date.now() / 1000);",
                  "const sig = CryptoJS.HmacSHA256(ts + \".\" + body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set(\"webhook_body\", body);",
                  "pm.collectionVariables.set(\"webhook_signature\", `t=${ts},v1=${sig}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "const d = pm.response.json().duplicate;",
                  "console.log(d ? \"Evento duplicado: ignorado\" : \"Evento novo: será processado pelo worker\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Webhook - forged signature (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Signature",
                "value": "{{forged_signature}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/webhooks/acmepay",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "webhooks",
                "acmepay"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{forged_body}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Assina com um segredo ERRADO para simular um atacante.",
                  "const body = JSON.stringify({ id: \"evt_forged\", type: \"payment.succeeded\",",
                  "  data: { account_id: pm.collectionVariables.get(\"account_a\"), amount: 999999, currency: \"BRL\" } });",
                  "const ts = Math.floor(Date.now() / 1000);",
                  "const sig = CryptoJS.HmacSHA256(ts + \".\" + body, \"attacker-secret\").toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set(\"forged_body\", body);",
                  "pm.collectionVariables.set(\"forged_signature\", `t=${ts},v1=${sig}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"forged webhook rejected with 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account A (balance)",
          "request": {
            "method": "GET",
